{
  "name": "gloop-ui",
  "version": "0.1.0",
  "description": "Soft, blobby, fluid React components with liquid \"goo\" animations.",
  "keywords": ["react", "components", "ui", "animation", "motion", "goo", "blob", "liquid"],
  "author": "Fabio Biondi <info@fabiobiondi.com>",
  "license": "MIT",
  "homepage": "https://fabiobiondi.github.io/gloop-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiobiondi/gloop-ui.git",
    "directory": "packages/gloop-ui"
  },
  "bugs": "https://github.com/fabiobiondi/gloop-ui/issues",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && rolldown -c rolldown.dts.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint:package": "publint && attw --pack --profile esm-only --exclude-entrypoints styles.css",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "motion": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
