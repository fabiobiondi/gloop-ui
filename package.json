{
  "name": "gloop-ui-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w docs",
    "build": "npm run build -w gloop-ui && npm run build -w docs",
    "build:lib": "npm run build -w gloop-ui",
    "build:docs": "npm run build -w docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "oxlint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build:lib && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "motion": "^14.1.0",
    "oxlint": "^1.81.0",
    "publint": "^0.3.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "^1.2.13",
    "rolldown-plugin-dts": "^0.28.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
